{
  "id": "grant_access",
  "title": "Grant application access",
  "trigger": "\\bgrant .*access\\b|\\bgive .* access to\\b",
  "start": "ask_user",
  "nodes": [
    { "id": "ask_user", "type": "ask", "next": "fetch_apps", "field": "userName",
      "prompt": "Which **user** should I grant access to? (their username)" },
    { "id": "fetch_apps", "type": "fetch", "next": "ask_app",
      "tool": "getAllApplications_get", "as_key": "apps" },
    { "id": "ask_app", "type": "ask", "next": "fetch_all_roles", "field": "applicationId",
      "prompt": "Which **application**?", "options_from": "apps",
      "label_key": "applicationName", "value_key": "applicationId" },
    { "id": "fetch_all_roles", "type": "fetch", "next": "fetch_user_roles",
      "tool": "getApplicationRolesByAppId_get", "args": { "applicationId": "$applicationId" },
      "as_key": "all_roles" },
    { "id": "fetch_user_roles", "type": "fetch", "next": "filter_grantable",
      "tool": "getActiveUserAppRolesByAppIdAndUserName_post",
      "args": { "userName": "$userName", "applicationId": "$applicationId" },
      "as_key": "user_roles" },
    { "id": "filter_grantable", "type": "filter", "next": "check_grantable", "source": "all_roles",
      "as_key": "grantable", "exclude_source": "user_roles", "on": "applicationRoleId" },
    { "id": "check_grantable", "type": "branch", "field": "grantable_empty",
      "cases": { "Y": "say_all", "N": "ask_role" } },
    { "id": "say_all", "type": "say",
      "text": "This user already holds every role in that application — nothing to grant." },
    { "id": "ask_role", "type": "ask", "next": "confirm", "field": "roleName",
      "prompt": "Which **role** to grant? _(only roles they don't already have)_",
      "options_from": "grantable", "label_key": "roleName", "value_key": "roleName" },
    { "id": "confirm", "type": "confirm", "next": "do_grant",
      "summary": [["User", "userName"], ["Application", "applicationId_label"], ["Role", "roleName"]] },
    { "id": "do_grant", "type": "mutate", "next": "done", "tool": "addUserApplicationAndRole_post",
      "arg_map": { "userId": "userName", "applicationId": "applicationId", "applicationRoleId": "roleName" },
      "verify": { "tool": "getActiveUserAppRolesByAppIdAndUserName_post",
                  "args": { "userName": "$userName", "applicationId": "$applicationId" },
                  "match": { "userName": "$userName", "roleName": "$roleName" } } },
    { "id": "done", "type": "say", "text": "✅ Access granted." }
  ]
}
