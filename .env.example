# ════════════════════════════════════════════════════════════════════════════
# MCP Agent — Environment Variables
# Copy to .env.local and fill in real values.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=MCP Agent
APP_VERSION=1.0.0
ENV=development            # development | staging | production
DEBUG=false
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
RELOAD=false               # Hot-reload (dev only)
WORKERS=1

# CORS — comma-separated origins, or * for open
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── MCP / Spring Boot backend ─────────────────────────────────────────────
# Full MCP API root (including any context path).  JAVA_MCP_BASE_URL takes
# precedence over MCP_BASE_URL so deploy configs only need one variable.
# Examples:
#   Local dev   : http://localhost:19170/mcp
#   Remote/K8s  : http://host:19170/mcp-service/mcp
JAVA_MCP_BASE_URL=http://localhost:19170/mcp
MCP_TIMEOUT_SECONDS=30
MCP_TOOLS_CACHE_TTL=600    # Seconds to cache tool list
MCP_API_KEY=               # X-API-KEY header sent to MCP server
MCP_BEARER_TOKEN=          # Authorization: Bearer token sent to MCP server

# ── LLM — OLLAMA (open-source, self-hosted) ───────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1         # Any model pulled into your OLLAMA instance
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_MAX_ITERATIONS=10      # Max agent loop iterations per request

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
SESSION_TTL_SECONDS=86400  # 24 hours

# ── Auth / RBAC ───────────────────────────────────────────────────────────────
AUTH_ENABLED=true
RBAC_ENABLED=true
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080   # 7 days

# ── Feature Flags ─────────────────────────────────────────────────────────────
TOOL_RISK_CONFIRMATION=true   # Require user confirmation for MEDIUM/HIGH risk tools
TOOL_CACHING_ENABLED=true
REDIS_ENABLED=true
REQUEST_LOGGING_ENABLED=true
AUDIT_LOGGING_ENABLED=true
STREAMING_ENABLED=true
RATE_LIMIT_ENABLED=false
CSP_ENABLED=true
DEBUG_TOOLS_ENABLED=false

# ── Agent System Prompt ───────────────────────────────────────────────────────
# Leave blank to use default
AGENT_SYSTEM_PROMPT=

# ── Platform integration (gc gateway-vouched auth) ──────────────────────────────
# standalone (default) = agent's own login;  gateway = trust gc gateway's X-INT-TKN
PLATFORM_AUTH_MODE=standalone
# Shared gc HMAC signing key (sealed at deploy from the DB setting) — verifies X-INT-TKN
GC_JWT_SECRET=
GC_JWT_ALGORITHM=HS512
GC_INTERNAL_ISSUER=GC_INTERNAL
GC_INTERNAL_AUDIENCE=GC_INTERNAL_API
GC_INTERNAL_HEADER=X-INT-TKN
GC_ROLE_HEADER=X-AR-KEY
GC_JWT_LEEWAY=30
# Path prefix when served behind the gateway rewrite (e.g. /ai-agent-service)
ROOT_PATH=

# ── Session / KV store ──────────────────────────────────────────────────────────
# opensearch (default) | redis | memory
STORE_BACKEND=opensearch
SESSION_TTL_SECONDS=86400
# OpenSearch (when STORE_BACKEND=opensearch)
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_INDEX=agent-kv
OPENSEARCH_TIMEOUT=10

# ── Observability (actuator pattern, matches the gc Spring services) ────────────
# Endpoints: <base>/health, /health/liveness, /health/readiness, /info, /prometheus
MANAGEMENT_BASE_PATH=/actuator
METRICS_ENABLED=true              # expose <base>/prometheus (+ /metrics alias)
ACTUATOR_ALLOWED_IPS=             # empty = allow all; e.g. 127.0.0.1,::1 for loopback-only
REQUEST_LOGGING_ENABLED=true      # structured access logs (request_id + trace_id correlated)
AUDIT_LOGGING_ENABLED=true
LOG_USER_PROMPTS=true             # log the end-user's question + tools RAG retrieved (chat_prompt line); off if PII-sensitive
