# ════════════════════════════════════════════════════════════════════════════
# MCP Agent — Environment Variables
# Copy to .env.local and fill in real values.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=MCP Agent
APP_VERSION=1.0.0
ENV=development            # development | staging | production
DEBUG=false
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
RELOAD=false               # Hot-reload (dev only)
WORKERS=1

# CORS — comma-separated origins, or * for open
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── MCP / Spring Boot backend ─────────────────────────────────────────────
MCP_BASE_URL=http://localhost:19170
MCP_TIMEOUT_SECONDS=30
MCP_TOOLS_CACHE_TTL=600    # Seconds to cache tool list
MCP_API_KEY=               # Optional API key for MCP server
MCP_BEARER_TOKEN=          # Bearer token forwarded to MCP server on every request

# ── LLM — OLLAMA (open-source, self-hosted) ───────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1         # Any model pulled into your OLLAMA instance
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_MAX_ITERATIONS=10      # Max agent loop iterations per request

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
SESSION_TTL_SECONDS=86400  # 24 hours

# ── Auth / RBAC ───────────────────────────────────────────────────────────────
AUTH_ENABLED=true
RBAC_ENABLED=true
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080   # 7 days

# ── Feature Flags ─────────────────────────────────────────────────────────────
TOOL_RISK_CONFIRMATION=true   # Require user confirmation for MEDIUM/HIGH risk tools
TOOL_CACHING_ENABLED=true
REDIS_ENABLED=true
REQUEST_LOGGING_ENABLED=true
AUDIT_LOGGING_ENABLED=true
STREAMING_ENABLED=true
RATE_LIMIT_ENABLED=false
CSP_ENABLED=true
DEBUG_TOOLS_ENABLED=false

# ── Agent System Prompt ───────────────────────────────────────────────────────
# Leave blank to use default
AGENT_SYSTEM_PROMPT=
